# ========================================================
# BETASNACKS BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/betasnacks?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/betasnacks?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=betasnacks_super_secret_production_key_987654321_jwt
JWT_EXPIRES_IN=7d

# Frontend Client Origin
FRONTEND_URL=http://localhost:5173

# Cloudinary Image Upload (Optional for custom dish uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Test Mode Payment Gateway
RAZORPAY_KEY_ID=rzp_test_betasnacks123
RAZORPAY_KEY_SECRET=betasnacks_test_secret_key

